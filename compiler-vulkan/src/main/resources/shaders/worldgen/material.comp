#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Density { uint densityBits[]; };
layout(std430, binding = 1) writeonly buffer Materials { uint stateIds[]; };
layout(push_constant) uniform Dispatch { uint count; } dispatch;
void main() { uint index = gl_GlobalInvocationID.x; if (index >= dispatch.count) return; stateIds[index] = densityBits[index]; }
