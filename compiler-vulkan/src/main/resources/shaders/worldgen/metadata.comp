#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Materials { uint stateIds[]; };
layout(std430, binding = 1) writeonly buffer Metadata { uint metadata[]; };
layout(push_constant) uniform Dispatch { uint count; } dispatch;
void main() { uint index = gl_GlobalInvocationID.x; if (index >= dispatch.count) return; metadata[index] = stateIds[index] == 0u ? 0u : 1u; }
